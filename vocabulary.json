{
  "version": "0.1.0",
  "name": "@gratiaos/protocol/vocabulary",
  "description": "Gratia ISA — Instruction Set Architecture for human state processing",
  "verbs": [
    {
      "id": "breathe",
      "symbol": "🫁",
      "category": "interior",
      "name": "Breathe (ES: Respira, RO: Respiră)",
      "description": "Return to the body through conscious breathing. Reduces cognitive load and brings attention back to the present.",
      "effects": [
        {
          "type": "state_change",
          "target": "mood",
          "from": ["contracted", "anxious", "frustrated"],
          "to": "open"
        },
        {
          "type": "state_change",
          "target": "cognitive_load",
          "direction": "reduce"
        },
        {
          "type": "signal_emitted",
          "target": "energy",
          "mark": "calm"
        }
      ],
      "adaptations": {
        "cli": {
          "message": "Stop everything. 3 deep breaths. In 4, hold 4, out 6.",
          "duration_seconds": 30
        },
        "firegate": {
          "action": "ask_gentle_questions",
          "questions": ["What do you feel in your body right now?", "Where does the tension stop?"]
        },
        "garden": {
          "heartware_state": "CALM",
          "css_effect": "pulse-slow"
        },
        "m3": {
          "action": "log_emotion",
          "kind": "calm",
          "intensity": 0.7
        }
      },
      "next_verb_suggestions": ["orient", "cartography"],
      "contraindications": ["flow"]
    },
    {
      "id": "orient",
      "symbol": "🧭",
      "category": "interior",
      "name": "Orient (ES: Oriéntate, RO: Încotro)",
      "description": "Spatial and temporal repositioning. Answers: where am I? when am I? what cycle am I in?",
      "effects": [
        {
          "type": "state_change",
          "target": "mood",
          "from": ["confused"],
          "to": "clarity"
        },
        {
          "type": "signal_emitted",
          "target": "energy",
          "mark": "clarity"
        },
        {
          "type": "state_change",
          "target": "band",
          "from": ["heavy"],
          "to": "open"
        }
      ],
      "adaptations": {
        "cli": {
          "message": "Stop. Where are you? What time is it? What cycle are you in right now?",
          "duration_seconds": 45
        },
        "firegate": {
          "action": "contextualize",
          "questions": ["What is happening right now?", "What preceded this moment?", "What comes next?"]
        },
        "garden": {
          "heartware_state": "OPEN",
          "css_effect": "focus-in"
        },
        "m3": {
          "action": "log_emotion",
          "kind": "clarity",
          "intensity": 0.8
        }
      },
      "next_verb_suggestions": ["cartography", "crystallize"],
      "contraindications": []
    },
    {
      "id": "jump",
      "symbol": "🐸",
      "category": "interior",
      "name": "Jump (ES: Salta, RO: Sari)",
      "description": "Shift the frame of reference. Look at the situation from a completely new perspective.",
      "effects": [
        {
          "type": "state_change",
          "target": "mood",
          "from": ["contracted", "heavy"],
          "to": "flow"
        },
        {
          "type": "signal_emitted",
          "target": "energy",
          "mark": "focus"
        },
        {
          "type": "state_change",
          "target": "perspective",
          "direction": "shifted"
        }
      ],
      "adaptations": {
        "cli": {
          "message": "If you looked at this from the perspective of 3 years from now, what would look different?",
          "duration_seconds": 60
        },
        "firegate": {
          "action": "reframe",
          "questions": ["What would a stranger say about your situation?", "If you didn't have this problem, what would you be doing instead?"]
        },
        "garden": {
          "heartware_state": "VORTEX",
          "css_effect": "rotate-slow"
        },
        "m3": {
          "action": "log_emotion",
          "kind": "focus",
          "intensity": 0.75
        }
      },
      "next_verb_suggestions": ["cartography", "bridge"],
      "contraindications": ["calm"]
    }
  ]
}
