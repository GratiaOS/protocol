{
  "$schema": "https://gratiaos.dev/manifest/0.1.0.json",
  "name": "@gratiaos/pack-product",
  "version": "0.1.0",
  "title": "Product Domain Pack",
  "description": "Implements the Gratia protocol for product documentation. Defines how verbs like define, design, and discover produce BRDs, PRDs, and discovery artifacts in a product context.",
  "extends": "@gratiaos/gratia",
  "assets": {
    "templates": ["templates/brd.md", "templates/prd.md"],
    "guides": ["guides/writing.md", "guides/palette.md"]
  },
  "artifacts": ["artifacts/brd.manifest.json", "artifacts/prd.manifest.json"],
  "verbs": {
    "discover": ["discovery-notes"],
    "map": ["knowledge-map"],
    "define": ["brd"],
    "design": ["prd"],
    "experiment": ["spike"],
    "measure": ["success-metrics"],
    "govern": ["constraints"],
    "transition": ["rollout-plan"]
  }
}
